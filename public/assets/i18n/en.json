      "1": {
        "title": "How to add a product to the inventory?",
        "category": "Inventory",
        "steps": [
          "Go to the <strong>Inventory</strong> module in the side panel.",
          "Select \"Products\" and click <strong>Add product</strong>.",
          "Fill in the form: name, price and initial stock.",
          "Save the changes — the product will appear in the catalog immediately."
        ]
      },
      "2": {
        "title": "How to connect the WhatsApp chatbot?",
        "category": "Chatbot",
        "steps": [
          "Go to the <strong>Chatbot</strong> module in the configuration panel.",
          "Press <strong>\"Connect WhatsApp\"</strong> to display the QR code.",
          "Scan the QR code from your <strong>WhatsApp Business</strong> app on your phone.",
          "Done! The chatbot is now active and can receive and respond to messages."
        ]
      },
      "3": {
        "title": "How to validate a payment from the dashboard?",
        "category": "Orders & Payment",
        "steps": [
          "Access the <strong>Orders</strong> module from the side panel.",
          "Filter orders with status \"Awaiting receipt\".",
          "Open the order and review the receipt image sent by the client.",
          "Press <strong>Approve payment</strong> if valid, or <strong>Reject</strong> with a reason."
        ]
      },
      "4": {
        "title": "How to manage expiry dates in lots?",
        "category": "Lots",
        "steps": [
          "Go to the <strong>Inventory</strong> module and select the <strong>Lots</strong> tab.",
          "Review the \"Expiry date\" column — lots expiring soon are highlighted.",
          "Critical lots generate <strong>stock alerts</strong> automatically on the home page.",
          "Edit a lot to adjust the date or available quantity."
        ]
      },
      "5": {
        "title": "How to check the daily cash summary?",
        "category": "Sales · Cash",
        "steps": [
          "Go to the <strong>Sales</strong> module from the side panel.",
          "The cash summary appears in the right side panel.",
          "It shows the <strong>Day total</strong>, Cash and Yape/Plin separately.",
          "It updates automatically with each completed sale."
        ]
      },
      "6": {
        "title": "What to do if the chatbot disconnects?",
        "category": "Chatbot",
        "steps": [
          "Go to the <strong>Chatbot</strong> module — you will see a \"Session expired\" notice in red.",
          "Press <strong>\"Reconnect\"</strong> to start the reconnection.",
          "Scan the new QR code from your WhatsApp Business app.",
          "The chatbot will resume its activity normally."
        ]
      },
      "7": {
        "title": "Can the chatbot send receipts automatically?",
        "category": "Chatbot",
        "steps": [
          "The chatbot <strong>receives</strong> receipts sent by clients via WhatsApp.",
          "It displays them automatically in the <strong>Orders</strong> module of the dashboard.",
          "The merchant must <strong>validate them manually</strong> — the system does not approve them automatically.",
          "After validation, the client receives an automatic confirmation via WhatsApp."
        ]
      },
